SECRET_KEY=generate_a_random_secret_key
GEMINI_API_KEY=your_gemini_api_key_here

# Business info printed on receipts
VITE_BUSINESS_NAME=Nombre del Negocio
VITE_BUSINESS_RUC=0000000000001
VITE_BUSINESS_ADDRESS=Dirección del Negocio

# USB receipt printer — get from Windows Device Manager > printer > Properties > Details > Hardware Ids
# Format: 0x04B8  (hex with 0x prefix)  or  1208  (decimal) — both work
VITE_PRINTER_VENDOR_ID=
VITE_PRINTER_PRODUCT_ID=
